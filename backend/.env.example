# Backend Environment Variables

# Required
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
PORT=5110

# Database (Production - PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional
FLASK_ENV=development
# FLASK_ENV=production  # Uncomment for production

# Auto-set by hosting platforms
# RENDER=true

# Gmail SMTP (admin OTP emails). Use an App Password, not your normal Gmail password.
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification on the account)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=adminkgplaunchpad@gmail.com
# SMTP_PASS=your-16-char-app-password
# ADMIN_EMAIL=adminkgplaunchpad@gmail.com
# FROM_NAME=KGP Launchpad
